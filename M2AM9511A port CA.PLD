Name     M2AM9511_GAL for M2 Calculator using AM9511A on M2AM9511A; 
PartNo   00 ;
Date     20/7/24 ; /* Last update: 5/8/24 */
Revision 02 ;
Designer Ruud ;
Company  KX ;
Assembly None ;
Location   U5 ;
Device   G22V10; /* Designed for GAL22V10D */

/* **  Operators
   !   NOT
   &   AND
   #   OR
   $   XOR
   **  *********/

/* Defines */

$DEFINE HIGH 'b'1
$DEFINE LOW  'b'0
$DEFINE ON   'b'1
$DEFINE OFF  'b'0

/* *************** INPUT PINS *********************/

PIN [1..8]  = [A0, A1, A2, A3, A4, A5, A6, A7]  ; /* addressing ports(all inverted)*/ 
PIN  9	= RD			; /* RD*    from Model II bus */ 
PIN 10  = WR  			; /* WD*    from Model II bus */ 
PIN 11  = IOCYC 		; /* IOCYC* from Model II bus */ 
PIN 14  = RESET  		; /* RESET* from Model II bus */ 

/* *************** OUTPUT PINS ******************** */

PIN  13	= J5			; /* SPARE INPUT*/
PIN  15	= RESETLN		; /* RESET for AM9511 (inverted from Z80) */
PIN  16	= J4			; /* SPARE I/O */
PIN  17	= J3			; /* SPARE I/O */
PIN  18 = J2			; /* SPARE I/O */
PIN  19	= WR_A			; /* WR* for AM9511 */
PIN  20	= RD_A			; /* RD* for AM9511 */
PIN  21 = DGATE			; /* DataGate for 74LS640 */
PIN  22	= CS			; /* CS* for AM9511 */
PIN  23	= A0_A			; /* A0 (non-inverted) for AM9511 */

/* *************** POWER PINS	******************** */
/* PIN 12 GROUND				     */
/* PIN 24 +5V					     */

/* *************** PIN NODES    ******************** */

RESETLN = ! RESET	;
PORT_CA	= A7 # A6 # ! A5 # ! A4 # A3 # ! A2 # A1 ; 
/* Note: the address on the Model II bus are inverted !! */
/*				; CA  = 11001010
				; CB  = 11001011
				; CAB = 1100101
				; CAB = 0011010 using inverted A7 ~ A1 		*/
CS	= IOCYC # PORT_CA 	; /* CS* (Select AM9511) on port CA and CB.	*/
WR_A	= WR # CS		; /* Only activate WR when AM9511 is selected	*/
RD_A	= RD # CS		; /* Only activate RD when AM9511 is selected	*/
DGATE   = CS			;
A0_A	= ! A0			; /* Adress line A0* inverted to A0 */

/* ****************************************************************************	*/
/* DEBUGGING BELOW HERE								*/
/* ****************************************************************************	*/

/* Debugging outputs can be re-used when needed */
J2	= CS			; /* CS* (Select AM9511) on port CA and CB.	*/
J3	= WR_A			; /* Only activate WR when AM9511 is selected 	*/
J4	= RD_A			; /* Only activate RD when AM9511 is selected 	*/
/* J5	= not used */


